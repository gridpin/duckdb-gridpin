# name: test/sql/gridpin.test
# description: gridpin_ext contracts that hold without a data sheet
# group: [gridpin]

require gridpin_ext

# every scalar function is registered under its documented name
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name LIKE 'gridpin%';
----
5

# a query before gridpin_load must fail with a usable hint, not crash
statement error
SELECT gridpin_geocode('10 rue de rivoli paris');
----
call gridpin_load

# reverse geocoding before gridpin_load fails the same way
statement error
SELECT gridpin_reverse(48.8584, 2.2945);
----
call gridpin_load

# a sheet path that does not exist is a clean error, not a crashed process
statement error
SELECT gridpin_load('definitely-not-a-sheet.bin');
----
cannot open
